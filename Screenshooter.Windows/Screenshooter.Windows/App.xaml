<Application x:Class="Screenshooter.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Tipografía del sistema y tokens de color -->
            <SolidColorBrush x:Key="AccentBlue" Color="#0A84FF" />
            <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E" />
            <SolidColorBrush x:Key="BorderSubtle" Color="#28FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
