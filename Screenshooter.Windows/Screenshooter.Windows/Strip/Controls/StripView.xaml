<UserControl x:Class="Screenshooter.Windows.Strip.Controls.StripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Screenshooter.Windows.Strip.Controls"
             Height="180">
    <Grid x:Name="RootGrid" Background="Transparent" SizeChanged="RootGrid_SizeChanged">
        <!-- Cuerda curvada con sombras y brillos -->
        <local:RopeCanvas x:Name="Rope" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Contenedor absoluto de tarjetas de capturas -->
        <Canvas x:Name="CardsCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
