<Window x:Class="Screenshooter.Windows.Capture.Windows.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelectionOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Focusable="True"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        MouseWheel="Window_MouseWheel"
        KeyDown="Window_KeyDown">

    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <!-- Máscara oscura con recorte transparente en el área seleccionada -->
        <Path x:Name="MaskPath" Fill="#33000000" />

        <!-- Rectángulo de selección con borde nítido -->
        <Rectangle x:Name="SelectionBorder"
                   Stroke="#0A84FF"
                   StrokeThickness="1.5"
                   Visibility="Collapsed" />

        <!-- Píldora de dimensiones ("800 × 600") -->
        <Border x:Name="DimensionPill"
                Background="#EE1E1E1E"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,3"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" />
            </Border.Effect>
            <TextBlock x:Name="DimensionText"
                       Foreground="#FFFFFF"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Text="0 × 0" />
        </Border>

        <!-- Indicador de modo Shift (Captura larga) -->
        <Border x:Name="ShiftHintPill"
                Background="#EE0A84FF"
                CornerRadius="6"
                Padding="8,3"
                Visibility="Collapsed">
            <TextBlock Text="⇧ Soltar para Captura Larga"
                       Foreground="#FFFFFF"
                       FontSize="11"
                       FontWeight="Bold" />
        </Border>
    </Canvas>
</Window>
